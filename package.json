{
  "name": "ai-logistics-mesh",
  "version": "1.0.0",
  "type": "module",
  "description": "Autonomous AI agent network for logistics orchestration using ASI Alliance",
  "main": "dist/index.js",
  "scripts": {
    "dev:orchestrator": "tsx watch src/agents/orchestrator/index.ts",
    "dev:truck1": "AGENT_ID=TRUCK1 tsx watch src/agents/truck/index.ts",
    "dev:truck2": "AGENT_ID=TRUCK2 tsx watch src/agents/truck/index.ts",
    "dev:truck3": "AGENT_ID=TRUCK3 tsx watch src/agents/truck/index.ts",
    "dev:warehouse1": "AGENT_ID=WAREHOUSE1 tsx watch src/agents/warehouse/index.ts",
    "dev:warehouse2": "AGENT_ID=WAREHOUSE2 tsx watch src/agents/warehouse/index.ts",
    "dev:supplier1": "AGENT_ID=SUPPLIER1 tsx watch src/agents/supplier/index.ts",
    "dev:supplier2": "AGENT_ID=SUPPLIER2 tsx watch src/agents/supplier/index.ts",
    "dev:supplier3": "AGENT_ID=SUPPLIER3 tsx watch src/agents/supplier/index.ts",
    "dev:oracle": "tsx watch src/agents/oracle/index.ts",
    "dev:planner": "tsx watch src/planner/index.ts",
    "dev:metta": "cd src/metta && uvicorn app:app --reload --port 8001",
    "build": "tsc",
    "start": "node dist/agents/orchestrator/index.js",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "ai",
    "agents",
    "logistics",
    "fetch.ai",
    "singularitynet",
    "metta",
    "asi-alliance"
  ],
  "author": "Timicoding",
  "license": "MIT",
  "dependencies": {
    "@googlemaps/google-maps-services-js": "^3.4.0",
    "fastify": "^4.26.2",
    "@fastify/websocket": "^10.0.1",
    "@fastify/cors": "^9.0.1",
    "mongoose": "^8.2.1",
    "zod": "^3.22.4",
    "pino": "^8.19.0",
    "pino-pretty": "^11.0.0",
    "dotenv": "^16.4.5",
    "uuid": "^9.0.1",
    "axios": "^1.6.7",
    "ws": "^8.16.0",
    "date-fns": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.5.10",
    "typescript": "^5.3.3",
    "tsx": "^4.7.1",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^7.1.0",
    "@typescript-eslint/parser": "^7.1.0",
    "prettier": "^3.2.5"
  }
}