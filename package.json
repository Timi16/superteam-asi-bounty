{
  "name": "ai-logistics-mesh",
  "version": "1.0.0",
  "type": "module",
  "description": "Autonomous AI agent network for logistics orchestration",
  "scripts": {
    "dev:orchestrator": "tsx watch src/agents/orchestrator/index.ts",
    "dev:truck": "tsx watch src/agents/truck/index.ts",
    "dev:warehouse": "tsx watch src/agents/warehouse/index.ts",
    "dev:supplier": "tsx watch src/agents/supplier/index.ts",
    "dev:oracle": "tsx watch src/agents/oracle/index.ts",
    "dev:planner": "tsx watch src/planner/index.ts",
    "dev:metta": "cd src/metta && uvicorn app:app --reload --port 8001",
    "build": "tsc",
    "start:orchestrator": "node dist/agents/orchestrator/index.js",
    "start:truck": "node dist/agents/truck/index.js",
    "start:warehouse": "node dist/agents/warehouse/index.js",
    "start:supplier": "node dist/agents/supplier/index.js",
    "start:oracle": "node dist/agents/oracle/index.js",
    "start:planner": "node dist/planner/index.js",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "@fetchai/uagents": "^0.2.0",
    "fastify": "^4.25.0",
    "zod": "^3.22.0",
    "pino": "^8.17.0",
    "pino-pretty": "^10.3.0",
    "dotenv": "^16.3.1",
    "uuid": "^9.0.1",
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.7",
    "typescript": "^5.3.0",
    "tsx": "^4.7.0",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "prettier": "^3.1.0"
  }
}